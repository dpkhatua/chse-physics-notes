<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ page_title }} | Odisha +2 Physics Notes</title>
<meta name="description" content="{{ description }}">
<link rel="stylesheet" href="{{ root }}assets/css/style.css">
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>✏️</text></svg>">
</head>
<body{% if chapter_id %} data-chapter-id="{{ chapter_id }}"{% endif %}>

<header class="site-header">
  <a class="brand" href="{{ root }}index.html"><span class="pencil-emoji">✏️</span> Odisha +2 Physics Notes</a>
  <button class="nav-toggle" aria-label="Menu">☰</button>
  <nav class="site-nav">
    <a href="{{ root }}index.html" class="{{ 'active' if active=='home' else '' }}">Home</a>
    <a href="{{ root }}class11/index.html" class="{{ 'active' if active=='c11' else '' }}">Class XI</a>
    <a href="{{ root }}class12/index.html" class="{{ 'active' if active=='c12' else '' }}">Class XII</a>
    <a href="{{ root }}class12book/index.html" class="{{ 'active' if active=='c12book' else '' }}">📘 Class XII (Textbook)</a>
    <a href="{{ root }}exam-strategy.html" class="{{ 'active' if active=='strategy' else '' }}">🎯 Exam Strategy</a>
  </nav>
</header>

<main class="page-wrap">
{% block content %}{% endblock %}
</main>

<footer class="site-footer">
  <p>Made with ✏️ for CHSE Odisha +2 Physics students &middot; Free forever, no login needed.</p>
  <p style="font-size:0.85rem;">Notes follow the CHSE Odisha rationalised Physics syllabus (Class XI &amp; XII, 2023–24). Please cross-check with your school textbook &amp; latest board circulars before exams.</p>
</footer>

<script src="{{ root }}assets/js/script.js"></script>
</body>
</html>
