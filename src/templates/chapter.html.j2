{% extends "base.html.j2" %}
{% block content %}
<div class="chapter-layout">
  <aside class="toc-box">
    <h4>📋 On this page</h4>
    <ol>
      {% for sec in sections %}
      <li><a href="#sec-{{ loop.index }}">{{ sec.heading }}</a></li>
      {% endfor %}
      <li><a href="#recap">Quick Recap</a></li>
      {% if exam_corner %}<li><a href="#exam-corner">🎯 Exam Corner</a></li>{% endif %}
    </ol>
    <label class="progress-check">
      <input type="checkbox" id="mark-read"> Mark chapter as read
    </label>
    <a class="back-link" href="index.html">&larr; Back to {{ class_label }} chapters</a>
  </aside>

  <article class="chapter-content">
    <div class="chapter-head">
      <div class="kicker">{{ class_label }} &middot; Unit {{ unit_roman }} &middot; Chapter {{ number }}</div>
      <h1>{{ title }}</h1>
      <p class="tagline">{{ tagline }}</p>
    </div>

    {% for sec in sections %}
    <section class="topic-section" id="sec-{{ loop.index }}">
      <h2><span class="sec-no">{{ loop.index }}</span> {{ sec.heading }}</h2>
      {% for blk in sec.blocks %}
        {% if blk.type == 'p' %}
        <p>{{ blk.text|safe }}</p>
        {% elif blk.type == 'list' %}
        <ul class="note-list">
          {% for item in blk['items'] %}<li>{{ item|safe }}</li>{% endfor %}
        </ul>
        {% elif blk.type == 'olist' %}
        <ol class="note-list">
          {% for item in blk['items'] %}<li>{{ item|safe }}</li>{% endfor %}
        </ol>
        {% elif blk.type == 'formula' %}
        <div class="formula-box">
          <div class="f-title">📐 {{ blk.title }}</div>
          {% for line in blk.lines %}<div class="f-line">{{ line|safe }}</div>{% endfor %}
        </div>
        {% elif blk.type == 'diagram' %}
        <div class="diagram-box">
          {% if blk.svg %}{{ blk.svg|safe }}{% endif %}
          <div class="cap">🖊️ {{ blk.caption }}</div>
        </div>
        {% elif blk.type == 'sticky' %}
        <div class="sticky-note {{ blk.color or 'yellow' }}">
          <span class="st-title">{{ blk.title }}</span>{{ blk.text|safe }}
        </div>
        {% elif blk.type == 'mnemonic' %}
        <div class="mnemonic-box"><span class="m-title">🧠 Yaad Rakho: </span>{{ blk.text|safe }}</div>
        {% elif blk.type == 'derivation' %}
        <div class="derivation-box">
          <div class="d-title">🧮 Derivation: {{ blk.title }}</div>
          {% if blk.given %}<div class="d-given"><b>Given / Setup:</b> {{ blk.given|safe }}</div>{% endif %}
          <ol class="d-steps">
            {% for step in blk.steps %}<li>{{ step|safe }}</li>{% endfor %}
          </ol>
          <div class="d-result">✅ {{ blk.result|safe }}</div>
        </div>
        {% elif blk.type == 'solved' %}
        <div class="solved-box">
          <div class="s-title">✏️ Solved Example</div>
          <div class="s-problem"><b>Q.</b> {{ blk.problem|safe }}</div>
          <ol class="s-steps">
            {% for step in blk.steps %}<li>{{ step|safe }}</li>{% endfor %}
          </ol>
          <div class="s-answer">🎯 Answer: {{ blk.answer|safe }}</div>
        </div>
        {% elif blk.type == 'mistake' %}
        <div class="mistake-box">⚠️ <b>Don't lose marks:</b> {{ blk.text|safe }}</div>
        {% elif blk.type == 'tip' %}
        <div class="tip-box">💡 <b>Score booster:</b> {{ blk.text|safe }}</div>
        {% endif %}
      {% endfor %}
    </section>
    {% endfor %}

    <div class="recap-box" id="recap">
      <h3>⚡ Quick Recap</h3>
      <ul>
        {% for point in recap %}<li>{{ point|safe }}</li>{% endfor %}
      </ul>
    </div>

    {% if exam_corner %}
    <div class="examcorner-box" id="exam-corner">
      <h3>🎯 Exam Corner — practice in CHSE question style</h3>
      <p class="ec-note">{{ exam_corner_note or "Grouped the way CHSE papers weight questions. These are practice questions written in the board's style to test this chapter — not lifted from any specific year's paper." }}</p>
      {% for m in [1,2,3,5] %}
        {% set items = exam_corner | selectattr('marks','equalto', m) | list %}
        {% if items %}
        <div class="ec-group">
          <span class="ec-marks">{{ m }} mark{{ 's' if m != 1 else '' }}</span>
          <ol>
            {% for it in items %}<li>{{ it.q|safe }}</li>{% endfor %}
          </ol>
        </div>
        {% endif %}
      {% endfor %}
    </div>
    {% endif %}

    <div class="chapter-nav">
      {% if prev %}<a href="{{ prev.id }}.html">&larr; {{ prev.title }}</a>{% else %}<span></span>{% endif %}
      {% if next %}<a href="{{ next.id }}.html">{{ next.title }} &rarr;</a>{% endif %}
    </div>
  </article>
</div>
{% endblock %}
